<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D1B2A" />
      <stop offset="50%" stop-color="#1B263B" />
      <stop offset="100%" stop-color="#0D1B2A" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E76F51" />
      <stop offset="100%" stop-color="#F4A261" />
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#A2D2FF" />
      <stop offset="100%" stop-color="#3A86FF" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bgGrad)" />
  
  <!-- Subtle Grid Lines -->
  <g stroke="#ffffff" stroke-opacity="0.05" stroke-width="1">
    <line x1="0" y1="90" x2="800" y2="90" />
    <line x1="0" y1="180" x2="800" y2="180" />
    <line x1="0" y1="270" x2="800" y2="270" />
    <line x1="0" y1="360" x2="800" y2="360" />
    <line x1="160" y1="0" x2="160" y2="450" />
    <line x1="320" y1="0" x2="320" y2="450" />
    <line x1="480" y1="0" x2="480" y2="450" />
    <line x1="640" y1="0" x2="640" y2="450" />
  </g>

  <!-- Network / Hub Graphic -->
  <g transform="translate(400, 180)">
    <polygon points="0,-60 52,-30 52,30 0,60 -52,30 -52,-30" fill="none" stroke="url(#blueGrad)" stroke-width="3" opacity="0.6" />
    <polygon points="0,-45 39,-22.5 39,22.5 0,45 -39,22.5 -39,-22.5" fill="none" stroke="url(#accentGrad)" stroke-width="2" opacity="0.8" />
    
    <!-- Central Node -->
    <circle cx="0" cy="0" r="16" fill="url(#accentGrad)" />
    <!-- Connecting Nodes -->
    <line x1="0" y1="0" x2="-70" y2="-40" stroke="#A2D2FF" stroke-width="2" opacity="0.7" />
    <line x1="0" y1="0" x2="70" y2="-40" stroke="#A2D2FF" stroke-width="2" opacity="0.7" />
    <line x1="0" y1="0" x2="0" y2="70" stroke="#A2D2FF" stroke-width="2" opacity="0.7" />
    <line x1="0" y1="0" x2="-80" y2="30" stroke="#E76F51" stroke-width="2" opacity="0.7" />
    <line x1="0" y1="0" x2="80" y2="30" stroke="#E76F51" stroke-width="2" opacity="0.7" />
    
    <circle cx="-70" cy="-40" r="8" fill="#A2D2FF" />
    <circle cx="70" cy="-40" r="8" fill="#A2D2FF" />
    <circle cx="0" cy="70" r="8" fill="#A2D2FF" />
    <circle cx="-80" cy="30" r="7" fill="#E76F51" />
    <circle cx="80" cy="30" r="7" fill="#E76F51" />
  </g>

  <!-- Typography -->
  <text x="400" y="320" font-family="'Montserrat', sans-serif" font-weight="800" font-size="28" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">COGNITA HUB</text>
  <text x="400" y="350" font-family="'Poppins', sans-serif" font-weight="400" font-size="14" fill="#A2D2FF" text-anchor="middle" letter-spacing="1">Conecte-se ao Conhecimento</text>
</svg>
